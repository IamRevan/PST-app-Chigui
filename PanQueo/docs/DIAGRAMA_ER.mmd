erDiagram
    PROVEEDORES {
        int id_proveedor PK
        varchar nombre
        varchar contacto
        varchar telefono
        text direccion
        datetime created_at
        datetime updated_at
    }

    INGREDIENTES {
        int id_ingrediente PK
        varchar nombre_ing UK
        decimal stock_minimo
        varchar unidad_medida
        int id_proveedor FK
        varchar categoria
        datetime created_at
        datetime updated_at
    }

    LOTES_INGREDIENTES {
        int id_lote PK
        int id_ingrediente FK
        decimal cantidad_actual
        decimal cantidad_inicial
        date fecha_ingreso
        date fecha_venc
        decimal precio_compra_unitario
        varchar moneda
        datetime created_at
        datetime updated_at
    }

    RECETAS {
        int id_receta PK
        varchar nombre_receta UK
        text instrucciones
        varchar rendimiento
        decimal precio_sugerido
        datetime created_at
        datetime updated_at
    }

    RECETA_INGREDIENTES {
        int id_receta_ing PK
        int id_receta FK
        int id_ingrediente FK
        decimal cantidad_requerida
        datetime created_at
        datetime updated_at
    }

    CLIENTES {
        int id_cliente PK
        varchar nombre
        varchar apellido
        varchar cedula UK
        varchar telefono
        text direccion
        int puntos_fidelidad
        datetime created_at
        datetime updated_at
    }

    PEDIDOS {
        int id_pedido PK
        int id_cliente FK
        int id_receta FK
        date fecha_pedido
        date fecha_entrega
