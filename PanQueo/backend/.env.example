PORT=3000
NODE_ENV=development
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=panqueo
# Cuenta de la aplicación: solo lee/escribe datos (sin DDL). Créala con:
#   npm run db:create-app-role -- panqueo_app
DB_USER=panqueo_app
DB_PASSWORD=your_app_password_here
# Cuenta administradora para migraciones y respaldos. La API nunca la usa.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=your_admin_password_here
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# --- Autenticación y sesiones ---
# Duración de la sesión (cookie httpOnly en web / token Bearer en móvil)
AUTH_SESSION_TTL_HOURS=12
AUTH_SESSION_COOKIE=pq_session
AUTH_CSRF_COOKIE=pq_csrf
# En producción debe quedar en true y el sitio debe servirse por HTTPS
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_ENFORCE_HTTPS=false
# 1 cuando la API está detrás de un proxy inverso (nginx, Railway, Render...)
TRUST_PROXY=
# URL pública del frontend: se usa en los enlaces de verificación/recuperación
APP_URL=http://localhost:5500
# Orígenes permitidos para CORS separados por coma (en desarrollo se permite localhost/LAN)
CORS_ORIGINS=http://localhost:5500

# Intentos fallidos antes de bloquear la cuenta y minutos de bloqueo
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT=10
AUTH_RECOVERY_RATE_LIMIT=5
AUTH_MFA_RATE_LIMIT=10

# Política de contraseñas: longitud y comprobación de filtraciones (HIBP k-anonymity)
AUTH_PASSWORD_MIN_LENGTH=12
PASSWORD_BREACH_CHECK=on
PASSWORD_BREACH_TIMEOUT_MS=3000

# Vigencia de enlaces
AUTH_VERIFY_TTL_HOURS=24
AUTH_RESET_TTL_MINUTES=30

# MFA TOTP (app autenticadora)
AUTH_MFA_ISSUER=PanQueo
AUTH_MFA_WINDOW=1
AUTH_MFA_TOKEN_TTL=5m

# --- Correo transaccional (SMTP) ---
# Sin SMTP_HOST la API sigue funcionando: los enlaces se registran en consola.
# (Ya no se devuelve dev_token/dev_link en la respuesta de la API.)
# Al definir SMTP_HOST el envío se activa automáticamente. MAIL_ENABLED=true/false
# permite forzarlo si fuera necesario.
# Ejemplos de host:
#   Gmail:    smtp.gmail.com:587 (requiere contraseña de aplicación y 2FA)
#   Outlook:  smtp.office365.com:587
#   Brevo:    smtp-relay.brevo.com:587
#   Resend:   smtp.resend.com:587 (usuario: resend, contraseña: API key)
#   Mailgun:  smtp.mailgun.org:587
#   SES:      email-smtp.<region>.amazonaws.com:587
SMTP_HOST=
SMTP_PORT=587
# true para puerto 465; false para 587 con STARTTLS
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remitente verificado en el proveedor, con nombre y correo
MAIL_FROM=PanQueo <no-reply@panqueo.com>
MAIL_REPLY_TO=
# Tiempo máximo de espera de SMTP (ms)
SMTP_TIMEOUT_MS=10000
# No lo pongas en false salvo con un servidor de correo con certificado autofirmado
SMTP_TLS_REJECT_UNAUTHORIZED=true

# --- Tasas oficiales BCV (USD y EUR) ---
# Cada cuántos minutos el backend vuelve a consultar bcv.org.ve (mínimo 5)
BCV_SYNC_INTERVAL_MIN=60
# Tiempo máximo de espera de cada petición al BCV / respaldo (ms)
BCV_TIMEOUT_MS=20000
# Cuánto tiempo se reutiliza el resultado en memoria antes de volver a consultar (ms)
BCV_CACHE_MS=300000
