        decimal monto_abonado
        varchar estado_pago
        varchar estado_entrega
        boolean es_delivery
        text direccion_delivery
        text observaciones
        datetime created_at
        datetime updated_at
    }

    USUARIOS {
        int id_usuario PK
        varchar nombre
        varchar apellido
        varchar email UK
        varchar telefono
        varchar password
        varchar rol
        boolean activo
        datetime created_at
        datetime updated_at
    }

    LISTA_COMPRAS {
        int id_lista PK
        date fecha_creacion
        varchar estado_lista
        text observaciones
        datetime created_at
        datetime updated_at
    }

    DETALLE_LISTA_COMPRAS {
        int id_detalle_lista PK
        int id_lista FK
        int id_ingrediente FK
        decimal cantidad_sugerida
        decimal cantidad_comprada
        decimal precio_estimado_unitario
        datetime created_at
        datetime updated_at
    }

    HISTORIAL_TASA_CAMBIO {
        int id_tasa PK
        date fecha_registro
        decimal valor_bs_por_usd
        varchar fuente_referencia
        datetime created_at
        datetime updated_at
    }

